# YieldSwarm — Environment Variable Template
# NEVER commit real values. Replace REPLACE_ME with actual credentials.
# Set all vars on Render: Dashboard → Environment → Add Variable
#
# Last updated: 2026-05-22

# =============================================================================
# CLOUD INFRASTRUCTURE
# =============================================================================
NEBULATOR_VPC_NETWORK=REPLACE_ME
NEBULATOR_SSH_KEY=REPLACE_ME
GPU_CLUSTER_SSH_KEY=REPLACE_ME

# =============================================================================
# BLOCKCHAIN RPC ENDPOINTS
# =============================================================================

# Solana (via Alchemy)
SOLANA_MAINNET_RPC=REPLACE_ME
SOLANA_DEVNET_RPC=REPLACE_ME
ALCHEMY_API_KEY=REPLACE_ME

# Zcash (public endpoints — no key required for reads)
ZCASH_MAINNET_RPC=https://zec.blockexplorer.com/api
ZCASH_TESTNET_RPC=https://testnet.zec.blockexplorer.com/api

# Bittensor
TAO_RPC=wss://entrypoint-finney.opentensor.ai:443
TAOSTATS_API=https://api.taostats.io
TAO_API_KEY=REPLACE_ME
BITTENSOR_ENDPOINT=REPLACE_ME
BITTENSOR_SEED=REPLACE_ME

# TON (already set via IRONFORGE)
TON_API_KEY=REPLACE_ME

# =============================================================================
# MARKET DATA
# =============================================================================
GOLDAPI_KEY=REPLACE_ME
SCRAPER_API_KEY=REPLACE_ME

# =============================================================================
# AI / LLM
# =============================================================================
PERPLEXITY_API_KEY=REPLACE_ME
PERPLEXITY_ACTIVATED=true
TOGETHER_API_KEY=REPLACE_ME
AKASH_API_KEY=REPLACE_ME

# =============================================================================
# AGENT INFRASTRUCTURE
# =============================================================================
COUNCIL_TELEGRAM_BOT_TOKEN=REPLACE_ME
COUNCIL_TELEGRAM_CHAT_ID=REPLACE_ME

# =============================================================================
# DEFI / YIELD
# =============================================================================
KAMINO_RPC=https://api.mainnet-beta.solana.com
DRIFT_PROTOCOL=https://drift.protocol.network
WZEC_UNISWAP_V3=https://uniswap.org

# =============================================================================
# WALLET SECURITY
# =============================================================================
# Generate once with: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
# NEVER log or expose this value in plaintext
WALLET_ENCRYPTION_KEY=REPLACE_ME

# =============================================================================
# FEATURE FLAGS
# =============================================================================
PERPLEXITY_ACTIVATED=false
FEATURE_BOUNTY_ENABLED=true
FEATURE_HELIX_DEPLOY=true
FEATURE_AGENT_SWARM=true
FEATURE_MOBILE_APP=false
FEATURE_BITAXE_COUNTER=false

# =============================================================================
# PAYMENT RAILS
# =============================================================================
KRAKEN_API_KEY=REPLACE_ME
KRAKEN_API_SECRET=REPLACE_ME
KRAKEN_PAY_ADDRESS=REPLACE_ME
SQUARE_ACCESS_TOKEN=REPLACE_ME
SQUARE_APPLICATION_ID=REPLACE_ME
SQUARE_WEBHOOK_SIGNATURE_KEY=REPLACE_ME

# =============================================================================
# CORE (REQUIRED — app crashes without these)
# =============================================================================
DATABASE_URL=REPLACE_ME
ADMIN_SECRET=REPLACE_ME
VAPID_PUBLIC_KEY=REPLACE_ME
VAPID_PRIVATE_KEY=REPLACE_ME
SITE_URL=REPLACE_ME
