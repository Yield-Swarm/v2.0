<body>
  <header><div class="logo">📊 Analytics</div>
    <nav><a href="/admin">Dashboard</a><a href="/admin/council-engine">Council</a><a href="/admin/wise-integration">Wise</a><a href="/admin/blueforge-mining">Mining</a><a href="/admin/analytics">Analytics</a><a href="/admin/settings">Settings</a></nav>
  </header>
  <div class="container">
    <h2 style="color:#eceef5;margin-bottom:1rem">Analytics Dashboard</h2>
    <div class="card"><h3>Traffic</h3><p style="color:#8a8ea6">No data yet. Connect GA4_MEASUREMENT_ID to activate.</p></div>
    <div class="card"><h3>Revenue</h3><p style="color:#8a8ea6">Vault yield and mining revenue tracking will appear here.</p></div>
  </div>
